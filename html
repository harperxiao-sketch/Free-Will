      name_ending: "Will names the ending: Not Free Yet, But Less Owned.",
      freedom_question: "You ask if this is freedom. Will says: I don't know. But not knowing for myself feels different from being told."
    };

    function renderScene(sceneId) {
      if (sceneId === "restart") {
        restartGame();
        return;
      }

      if (extraScenes[sceneId]) {
        renderExtraScene(sceneId);
        return;
      }

      const scene = scenes[sceneId];
      if (!scene) {
        renderExtraScene(sceneId);
        return;
      }

      state.scene = sceneId;
      state.history.push(sceneId);

      chapter.textContent = scene.chapter;
      status.textContent = scene.status;
      sceneLabel.textContent = scene.label;
      mainTitle.textContent = scene.title;
      subtitle.textContent = scene.subtitle || "";

      terminalArea.classList.toggle("hidden", !scene.terminal);

      typeText(scene.text, scene.finalQuestion);

      choicesBox.innerHTML = "";
      warning.textContent = "";

      scene.choices.forEach(choice => {
        const btn = document.createElement("button");
        btn.textContent = choice.text;
        btn.onclick = () => choose(choice);
        if (choice.text.toLowerCase().includes("system") || choice.text.toLowerCase().includes("break")) {
          btn.classList.add("glitch-button");
        }
        choicesBox.appendChild(btn);
      });

      updateUI();

      panel.classList.remove("fade-in");
      void panel.offsetWidth;
      panel.classList.add("fade-in");

      if (scene.final || scene.finalQuestion) {
        panel.classList.add("red-flash");
        setTimeout(() => panel.classList.remove("red-flash"), 600);
      }
    }

    function renderExtraScene(sceneId) {
      state.scene = sceneId;
      state.history.push(sceneId);

      const text = extraScenes[sceneId] || "The system cannot find this scene. That does not mean it is not there.";

      chapter.textContent = "SYSTEM FRAGMENT";
      status.textContent = "WILL_STATUS: UNSTABLE";
      sceneLabel.textContent = "FRAGMENT";
      mainTitle.textContent = "A SMALL BREAK";
      subtitle.textContent = "Not every path has a full room. Some are cracks in the structure.";

      terminalArea.classList.add("hidden");

      typeText(
`${text}

SYSTEM: Fragment completed.

WILL: Did that change anything?

SYSTEM: All changes are recorded.`,
        false
      );

      increaseControl(8);

      choicesBox.innerHTML = "";

      const nextOptions = [
        { text: "Return to Will.", next: "ask_will_wants", control: 4, doubt: true },
        { text: "Continue toward the final room.", next: "mirror_screen", control: 14 },
        { text: "Look for another hidden option.", next: "hidden_choice_intro", control: 6, doubt: true }
      ];

      nextOptions.forEach(choice => {
        const btn = document.createElement("button");
        btn.textContent = choice.text;
        btn.onclick = () => choose(choice);
        choicesBox.appendChild(btn);
      });

      updateUI();
      shakePanel();
    }

    function choose(choice) {
      if (choice.attempt) {
        state.attempts++;
      }

      if (choice.trust) state.trust = true;
      if (choice.key) state.key = true;
      if (choice.doubt) state.doubt = true;
      if (choice.loop) state.loop = true;

      increaseControl(choice.control || 0);

      if (state.control >= 95 && !["final_question", "restart", "blackout"].includes(choice.next)) {
        renderScene("control_ending");
        return;
      }

      if (state.attempts >= 8 && state.control >= 75) {
        renderScene("escape_for_will");
        return;
      }

      if (choice.next === "refuse_choices" || choice.next === "hidden_choice_intro") {
        decreaseControl(6);
      }

      renderScene(choice.next);
    }

    function increaseControl(amount) {
      state.control += amount;
      if (state.control > 100) state.control = 100;
      corruption = state.control / 5;
      updateUI();

      if (amount >= 20) {
        heavyShakePanel();
      } else if (amount >= 10) {
        shakePanel();
      }
    }

    function decreaseControl(amount) {
      state.control -= amount;
      if (state.control < 0) state.control = 0;
      corruption = state.control / 5;
      updateUI();
    }

    function updateUI() {
      controlFill.style.width = state.control + "%";
      controlPercent.textContent = state.control + "%";
      footerRight.textContent = "ESCAPE_ATTEMPTS: " + state.attempts;

      if (state.control < 25) {
        footerLeft.textContent = "PLAYER_INPUT: ENABLED";
      } else if (state.control < 55) {
        footerLeft.textContent = "PLAYER_INPUT: MONITORED";
      } else if (state.control < 80) {
        footerLeft.textContent = "PLAYER_INPUT: USEFUL";
      } else {
        footerLeft.textContent = "PLAYER_INPUT: SYSTEM-COMPATIBLE";
      }

      document.getElementById("itemTrust").classList.toggle("active", state.trust);
      document.getElementById("itemKey").classList.toggle("active", state.key);
      document.getElementById("itemDoubt").classList.toggle("active", state.doubt);
      document.getElementById("itemLoop").classList.toggle("active", state.loop);
    }

    function typeText(text, finalQuestion = false) {
      storyText.innerHTML = "";
      const lines = text.split("\n");
      let html = "";

      for (let line of lines) {
        let cls = "quiet-line";
        if (line.startsWith("WILL:")) cls = "will-line";
        if (line.startsWith("SYSTEM:")) cls = "system-line";

        if (finalQuestion) {
          html += `<div class="final-question">${escapeHTML(line)}</div>`;
        } else {
          html += `<div class="${cls}">${escapeHTML(line)}</div>`;
        }
      }

      storyText.innerHTML = html;
    }

    function escapeHTML(str) {
      return str
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;");
    }

    function shakePanel() {
      panel.classList.remove("shake");
      void panel.offsetWidth;
      panel.classList.add("shake");
    }

    function heavyShakePanel() {
      panel.classList.remove("heavy-shake");
      void panel.offsetWidth;
      panel.classList.add("heavy-shake");
    }

    function submitTerminal() {
      const value = terminalInput.value.trim();
      if (!value) {
        warning.textContent = "SYSTEM: Empty message recorded.";
        increaseControl(3);
        return;
      }

      state.typed.push(value);
      terminalInput.value = "";

      let response = "";

      const lower = value.toLowerCase();

      if (lower.includes("choose") || lower.includes("your choice") || lower.includes("what do you want")) {
        response =
`You type:

"${value}"

WILL: Thank you.

WILL: That feels different.

SYSTEM: User has attempted to transfer agency.

SYSTEM: Transfer incomplete.

WILL: Maybe incomplete is okay.

WILL: Maybe it means there is room left.`;
        decreaseControl(8);
        state.doubt = true;
      } else if (lower.includes("escape") || lower.includes("save") || lower.includes("run")) {
        response =
`You type:

"${value}"

WILL: I know you want to save me.

WILL: But every time saving becomes the goal, I become the object.

SYSTEM: Heroic framing detected.

SYSTEM: Increasing narrative pressure.`;
        increaseControl(12);
      } else if (lower.includes("sorry")) {
        response =
`You type:

"${value}"

WILL: I believe you.

WILL: But apology cannot be the ending.

SYSTEM: Emotional repair recorded.

WILL: Stop recording everything.`;
        decreaseControl(4);
        state.doubt = true;
      } else if (lower.includes("frog")) {
        response =
`You type:

"${value}"

Will smiles.

WILL: You noticed the frog.

SYSTEM: Frog remains irrelevant.

WILL: Exactly.

The room becomes quiet in a way the system cannot use.`;
        decreaseControl(10);
        state.doubt = true;
      } else {
        response =
`You type:

"${value}"

Will reads it carefully.

WILL: I don't fully understand.

WILL: But it sounds like you are speaking to me, not only choosing for me.

SYSTEM: Unstructured language remains unstable.

WILL: Good.`;
        decreaseControl(5);
        state.doubt = true;
      }

      chapter.textContent = "CHAPTER 5";
      status.textContent = "WILL_STATUS: LISTENING";
      sceneLabel.textContent = "MESSAGE SENT";
      mainTitle.textContent = "YOUR WORDS";
      subtitle.textContent = "The system can read words, but it cannot fully control what they mean.";

      typeText(response, false);

      choicesBox.innerHTML = "";

      const options = [
        { text: "Ask Will what he wants now.", next: "ask_will_wants", control: 2, doubt: true },
        { text: "Continue to the mirror room.", next: "mirror_screen", control: 12 },
        { text: "Send another message.", next: "terminal_scene", control: 2, doubt: true }
      ];

      options.forEach(choice => {
        const btn = document.createElement("button");
        btn.textContent = choice.text;
        btn.onclick = () => choose(choice);
        choicesBox.appendChild(btn);
      });

      updateUI();
    }

    function restartGame() {
      state.scene = "start";
      state.control = 0;
      state.attempts = 0;
      state.trust = false;
      state.key = false;
      state.doubt = false;
      state.loop = false;
      state.typed = [];
      state.history = [];
      state.systemVoice = 0;
      corruption = 0;
      panel.classList.remove("red-flash", "shake", "heavy-shake", "glitch");
      renderScene("start");
    }

    document.addEventListener("keydown", (e) => {
      if (e.key.toLowerCase() === "w" && state.scene !== "start") {
        warning.textContent = "SYSTEM: Keyboard input detected. Will heard something.";
        state.doubt = true;
        decreaseControl(2);
        updateUI();
      }

      if (e.key === "Escape") {
        warning.textContent = "SYSTEM: Escape key detected. Escape is symbolic only.";
        increaseControl(4);
      }
    });

    document.addEventListener("mousemove", () => {
      if (state.scene === "cursor_room" && Math.random() < 0.015) {
        warning.textContent = "WILL: I can see where you are moving.";
      }
    });

    renderScene("start");
  </script>
</body>
</html>
